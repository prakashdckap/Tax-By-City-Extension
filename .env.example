# Copy to .env and fill in values. Never commit .env — use Adobe I/O Runtime / GitHub secrets for deploy.
# Docs: https://developer.adobe.com/app-builder/docs/guides/application_state/

AIO_runtime_auth=<namespace>:<ow_auth_key>
AIO_runtime_namespace=<your-runtime-namespace>
AIO_runtime_apihost=https://adobeioruntime.net
RUNTIME_API_HOST=https://adobeioruntime.net
APP_BUILDER_DB_URL_TEMPLATE=https://storage-database-<region>.app-builder.int.adp.adobe.io

AIO_ims_contexts_Credential__in__Tax__By__City__-__Production_client__id=<ims_client_id>
AIO_ims_contexts_Credential__in__Tax__By__City__-__Production_client__secrets=["<client_secret>"]
AIO_ims_contexts_Credential__in__Tax__By__City__-__Production_technical__account__email=<techacct@techacct.adobe.com>
AIO_ims_contexts_Credential__in__Tax__By__City__-__Production_technical__account__id=<technical_account_id>
AIO_ims_contexts_Credential__in__Tax__By__City__-__Production_scopes=<json_array_of_scopes>

AIO_ims_contexts_Credential__in__Tax__By__City__-__Production_ims__org__id=<org_id@AdobeOrg>
AIO_ims_contexts_Project__1765779600988K_client__id=<project_client_id>

SERVICE_API_KEY=<optional>
MAGENTO_API_KEY=<optional>

ADOBE_CLIENT_ID=<same_as_ims_oauth_client_id>
ADOBE_CLIENT_SECRET=<client_secret>
ADOBE_ORG_ID=<org_id@AdobeOrg>
ADOBE_TOKEN_URL=https://ims-na1.adobelogin.com/ims/token/v3
ADOBE_SCOPE_EXTENDED=<json_scopes_array>

IMS_OAUTH_S2S_CLIENT_ID=<client_id>
IMS_OAUTH_S2S_CLIENT_SECRET=<client_secret>
IMS_OAUTH_S2S_ORG_ID=<org_id@AdobeOrg>
MAGENTO_IMS_ORG_ID=<org_id@AdobeOrg>
IMS_OAUTH_S2S_SCOPES=<json_scopes_array>

RUNTIME_USERNAME=<ow_namespace_uuid>
RUNTIME_PASSWORD=<ow_auth_key>
# Base64(RUNTIME_USERNAME:RUNTIME_PASSWORD) — for app.config.yaml and inject-runtime-auth-for-web.mjs
RUNTIME_AUTH_BASE64=<base64_string>

DEFAULT_REGION=amer
DEFAULT_LIMIT=100
MAX_LIMIT=1000
TAX_RATES_COLLECTION=tax_rates
SYNC_HISTORY_COLLECTION=sync_history
MAGENTO_WEBSITE_CODE=base
MAGENTO_STORE_CODE=main_website_store
MAGENTO_STORE_VIEW_CODE=default
MAGENTO_DEFAULT_SKU=WS12-M-Orange
MAGENTO_COMMERCE_DOMAIN=<tenant>.api.commerce.adobe.com
AIO_COMMERCE_AUTH_IMS_CLIENT_ID=<client_id>
AIO_COMMERCE_AUTH_IMS_CLIENT_SECRETS=["<client_secret>"]
AIO_COMMERCE_AUTH_IMS_TECHNICAL_ACCOUNT_EMAIL=<techacct@techacct.adobe.com>
AIO_COMMERCE_AUTH_IMS_TECHNICAL_ACCOUNT_ID=<technical_account_id>
AIO_COMMERCE_AUTH_IMS_SCOPES=<json_scopes_array>
AIO_COMMERCE_AUTH_IMS_ORG_ID=<org_id@AdobeOrg>

# Out-of-process tax webhook (collect-taxes) — paste public key from Commerce Admin > Webhooks > Digital Signature
# When unset, signature verification is skipped (ok for manual tests). Set this in production.
COMMERCE_WEBHOOKS_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
# Force-disable verification (non-production only). Optional if COMMERCE_WEBHOOKS_PUBLIC_KEY is empty.
# SKIP_WEBHOOK_SIGNATURE_VERIFY=true

# collect-taxes / calculate-tax-rate — max App Builder tax_rates rows to load per request (default 1000)
# OOP_TAX_DB_FIND_LIMIT=1000
